# ============================================================
# Smart Campus Lost & Found - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MySQL Database ---
# For local development: use 127.0.0.1
# For Clever Cloud production: use the host from your Clever Cloud MySQL dashboard
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=smart_lost_found

# Set to true if your cloud database requires SSL (Clever Cloud does NOT require this,
# but some providers like Aiven do). Leave blank or false for local.
DB_SSL=false

# --- JWT Authentication ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_very_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# --- File Uploads ---
MAX_FILE_SIZE_MB=5

# --- CORS (allowed frontend origins, comma-separated) ---
# Local: http://localhost:5173
# Production: https://your-app.onrender.com
FRONTEND_URL=http://localhost:5173

# --- Cloudinary Image Storage (required for production) ---
# Sign up free at https://cloudinary.com
# Find these in your Cloudinary Dashboard > Settings
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
