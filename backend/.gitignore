# ============================================================
# Smart Campus Lost & Found - .gitignore
# ============================================================

# Environment files (NEVER commit these)
.env
.env.local
.env.production
.env.staging
# Allow only the example/template file:
!.env.example

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Uploaded files (local only — use Cloudinary in production)
uploads/*
!uploads/.gitkeep

# Build outputs
dist/
build/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
*~

# Render / deployment artifacts
.render-buildpacks.json
